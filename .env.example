# Copy to .env and adjust. Values here are safe local-development defaults.

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=720
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

# --- Data stores (overridden by docker-compose for containers) -------------
DATABASE_URL=postgresql+asyncpg://campus:campus@localhost:5432/campus_lost
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3Mock locally, S3 / R2 in production) ----------------
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=campus-lost-photos
S3_ACCESS_KEY=dev-access-key
S3_SECRET_KEY=dev-secret-key
S3_REGION=us-east-1

# --- Email ------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Campus Lost & Found <no-reply@campus.ca>
# In development the login code is also written to the API log.
DEV_LOG_LOGIN_CODES=true

# --- LLM (any OpenAI-compatible endpoint) -----------------------------------
# Provider "none" uses the built-in rule-based assistant; the app works fully without an LLM.
# Groq:   LLM_PROVIDER=openai_compat  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.1-8b-instant
# Gemini: LLM_PROVIDER=openai_compat  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
# Ollama: LLM_PROVIDER=openai_compat  LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=qwen2.5:7b
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=12

# --- Embeddings -------------------------------------------------------------
# "hashing" is dependency-free and deterministic (good for dev/CI).
# "sentence_transformers" uses BAAI/bge-small-en-v1.5 (384-dim) for real semantic search.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Matching thresholds ----------------------------------------------------
MATCH_NOTIFY_THRESHOLD=0.70
MATCH_SUGGEST_THRESHOLD=0.45
ITEM_RETENTION_DAYS=60
LOST_REPORT_TTL_DAYS=60
